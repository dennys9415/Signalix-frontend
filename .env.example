NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# v0.9.0 E2EE beta — leave empty / "false" to use real Web Crypto end-to-end
# encryption for direct text messages. Set to "true" to fall back to the
# v0.8.0 plaintext-passthrough mock (useful when running against a peer
# that hasn't published keys, or when isolating UI work from crypto).
# Both modes use the same on-the-wire encryptionVersion field; the mock
# sends version 0 (plaintext) while the real Signal service sends version 1.
NEXT_PUBLIC_E2EE_DEV_FALLBACK=false
